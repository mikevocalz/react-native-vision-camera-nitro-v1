{
  "name": "react-native-vision-camera-resizer",
  "version": "5.2.5-nitro-v1.1",
  "description": "High-performance image and frame resizing plugin using Metal/Vulkan for react-native-vision-camera.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "lib/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/compile-shaders.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "apple/**/*.swift",
    "apple/**/*.metal",
    "nitro.json",
    "*.podspec",
    "Package.swift",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "build": "tsc --noEmit false --declaration",
    "specs": "nitrogen && tsc --noEmit",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "camera",
    "react-native-camera",
    "vision-camera",
    "image-resize",
    "resize",
    "frame-resize",
    "frame-processor",
    "pixel-format",
    "gpu",
    "metal",
    "vulkan",
    "ml",
    "image-processing",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/margelo/react-native-vision-camera.git"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/margelo/react-native-vision-camera/issues"
  },
  "homepage": "https://visioncamera.margelo.com/api/react-native-vision-camera-resizer",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "nitrogen": "1.0.0-alpha.nightly.138.g43e09c161101",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.138.g43e09c161101",
    "react-native-vision-camera": "workspace:*",
    "typescript": "7.0.2",
    "nitro-core": "1.0.0-alpha.nightly.138.g43e09c161101"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.88.0",
    "react-native-nitro-modules": "*",
    "react-native-vision-camera": ">=5.2.5-nitro-v1.1",
    "nitro-core": "*"
  },
  "peerDependenciesMeta": {
    "nitro-core": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "release-it": {
    "npm": {
      "publish": true
    },
    "git": false,
    "github": {
      "release": false
    },
    "hooks": {
      "before:init": "bun typecheck",
      "after:bump": "bun run build"
    }
  },
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "swiftpmConfig": {
    "name": "VisionCameraResizer",
    "dependencies": [
      "react-native-nitro-modules",
      "react-native-vision-camera"
    ]
  }
}
